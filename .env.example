# ============================================================
# TEELA DIGITAL — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values:
#
#   cp .env.example .env.local
#
# NEVER commit .env.local. Only variables prefixed with VITE_
# are exposed to the browser, and they end up in the shipped
# bundle in plain text — so never put an API secret under VITE_.
#
# All variables are optional. When one is unset the site degrades
# gracefully (see the fallback noted per variable).
#
# The two halves below are configured in different places on most
# hosts. VITE_* values go in the build environment; the server
# values go in the functions environment, and are read at request
# time by the code in api/.
# ============================================================

# ============================================================
# BROWSER — build time, public, ends up in the bundle
# ============================================================

# --- Contact form ------------------------------------------------
# Static endpoint enquiries are POSTed to if the /api/contact
# function is unavailable. Leave empty to skip straight to the
# mailto fallback.
# Example: VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
VITE_CONTACT_ENDPOINT="https://formspree.io/f/12edb830-268b-41a3-8879-559eefa3337c"

# Address used for the mailto fallback and shown in the footer.
# Note: this does not change where Formspree delivers, and it is
# not the address enquiries are read from — that is CONTACT_TO_EMAIL.
# Example: VITE_CONTACT_EMAIL=hello@teeladigital.com
VITE_CONTACT_EMAIL=teelatech@gmail.com

# --- Newsletter --------------------------------------------------
# Static endpoint signups are POSTed to if the /api/subscribe
# function is unavailable. Leave empty to run in demo mode, where
# the signup is accepted in the UI but nothing is transmitted.
VITE_NEWSLETTER_ENDPOINT="https://formspree.io/f/xaenpgdw"

# --- Optional ----------------------------------------------------
# Origin serving the /api/* functions. Leave empty for same-origin,
# which is correct whenever the functions ship with the site. Only
# set this if they live on a separate domain, which must then send
# permissive CORS headers.
# Example: VITE_API_BASE=https://api.teeladigital.com
VITE_API_BASE=

# Absolute origin of the deployed site, used for canonical URLs,
# Open Graph, sitemap and structured data. Without it the build
# cannot emit absolute URLs, so set it in production.
# Example: VITE_SITE_URL=https://www.teelatech.com
VITE_SITE_URL="https://www.teelatech.com/"

# ============================================================
# SERVER — request time, secret, never exposed to the browser
# ============================================================
# Configure these in the hosting provider's environment variable
# settings, NOT in a VITE_ variable. If they are missing the
# functions answer 503 and the site falls back to the static
# endpoints above, so nothing breaks.

# --- Resend (transactional email) --------------------------------
# API key from https://resend.com/api-keys, starting with "re_".
RESEND_API_KEY=

# Verified sender the emails are sent from. Resend only permits
# sending from a domain you have verified.
# Example: EMAIL_FROM="Teela Tech <teelatech@gmail.com>"
EMAIL_FROM=

# --- Addresses ---------------------------------------------------
# Where website enquiries are delivered. This is the inbox that
# actually receives the contact form.
CONTACT_TO_EMAIL=teelatech@gmail.com

# --- Link signing ------------------------------------------------
# Secret used to sign newsletter confirmation and unsubscribe
# links. Any long random string; changing it invalidates links
# that have already been sent. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_TOKEN_SECRET=
